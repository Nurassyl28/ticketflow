# Только локальная разработка. Эти же значения использует Docker Compose.
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow_dev
POSTGRES_DB=ticketflow
POSTGRES_PORT=55432

APP_NAME=TicketFlow
DATABASE_URL=postgresql+psycopg://ticketflow:ticketflow_dev@127.0.0.1:55432/ticketflow

# Отдельная переменная для явного запуска интеграционных тестов.
# Тесты создают и удаляют свои временные схемы; нужны права CREATE SCHEMA.
TEST_DATABASE_URL=postgresql+psycopg://ticketflow:ticketflow_dev@127.0.0.1:55432/ticketflow
